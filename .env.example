# SPIDYY CLOUD — Environment Configuration
# Copy to .env for local Node runtime or configure via Wrangler secrets for Cloudflare Workers.

# Runtime port for local preview server
PORT="3000"

# Public origin used for generated live URLs and GitHub Actions workflow templates
APP_URL="http://localhost:3000"

# Optional separate hosting worker URL in production (recommended for tenant origin isolation)
# Example: https://spidyy-sites.YOUR_SUBDOMAIN.workers.dev
SPIDYY_HOSTING_ORIGIN=""

# Set to "true" only if an email recovery provider is configured (otherwise forgot-password stays honestly disabled)
SPIDYY_EMAIL_RECOVERY_ENABLED="false"
